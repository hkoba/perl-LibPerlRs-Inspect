#!include_default

# cargo build artifacts
^target/

# development-only files (not shipped in the dist)
^docs/
^plan\.md$
^gemini-advice\.md$
^test\.zsh$
^\.gitignore$
^\.claude/

# EUMM / dist products (mostly covered by include_default; explicit for clarity)
^Makefile$
^Makefile\.old$
^MYMETA\.
^META\.yml$
^META\.json$
^pm_to_blib$
^blib/
^LibPerlRs-Inspect-[\d.]+/
^LibPerlRs-Inspect-[\d.]+\.tar\.gz$
